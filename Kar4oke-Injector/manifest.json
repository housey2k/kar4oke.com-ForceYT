{
  "name": "KAR4OKE Injector",
  "description": "KAR4OKE HTML IFrame Injection",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "hello.html",
    "default_icon": "favicon.png"
  },
  "permissions": ["scripting"],
  "host_permissions": ["https://kar4oke.com/*"],
  "content_scripts": [
    {
      "matches": ["https://kar4oke.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
